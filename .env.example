# configuration for local development

# app context: 'dev' skips jwt signature verification, 'prod' enforces it
APP_ENV=dev

# database connection
# format: postgres://<user>:<password>@<host>:<port>/<db_name>?sslmode=disable
DATABASE_URL=postgres://user:password@localhost:5432/location_db?sslmode=disable

# message queue (kafka)
KAFKA_BROKER=localhost:9092

# ports for different services
PORT=8081             # used by tenant service
INGESTION_PORT=8082   # used by ingestion service

# aws cognito (only required if APP_ENV=prod)
# format: https://cognito-idp.<region>.amazonaws.com/<user_pool_id>/.well-known/jwks.json
COGNITO_JWKS_URL=
