# Environment Configuration

# App env (dev or prod)
# dev: Skips JWT signature verification (allows using jwt.io tokens for testing)
# prod: Enforces strict signature verification using COGNITO_JWKS_URL
APP_ENV=dev

# Database Connection String
DATABASE_URL=postgres://user:password@localhost:5432/location_db?sslmode=disable

# Service Ports
PORT=8081

# AWS cognito configuration (required for prod mode)
# URL to fetch the JSON Web Key Set (public keys)
# format: https://cognito-idp.{region}.amazonaws.com/{userPoolId}/.well-known/jwks.json
COGNITO_JWKS_URL=
